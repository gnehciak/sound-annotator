# Backend config — everything is provisioned through the linked Vercel project
# (Neon Postgres, Vercel Blob) except the Google OAuth client, which lives in
# your own Google Cloud console. Don't fill this in by hand: run
#
#   vercel env pull
#
# to sync `.env.local`, then restart the dev server. Nothing here ships in the
# client bundle — sign-in is entirely server-side, so there is no VITE_ key for
# it at all (the browser asks GET /api/auth/me who it is).

# --- Sign in with Google (api/auth/[action].ts) ------------------------------
# From Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). The redirect URI registered there must be exactly
#   https://annotated.lkcs.app/api/auth/callback   (and http://localhost:3000/…
# for `npm run dev:full`).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Signing key for the session cookie. Any long random string; rotating it
# signs everybody out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=

# Optional. Forces the origin used to build the OAuth redirect_uri, which
# otherwise comes from the request's forwarded headers. Only needed if a
# deployment is reached on a hostname Google doesn't have registered.
# AUTH_ORIGIN=https://annotated.lkcs.app

# --- Everything else (used by the /api functions) ----------------------------
# DATABASE_URL=            Neon Postgres (pooled)
# BLOB_READ_WRITE_TOKEN=   Vercel Blob store token
# REPLICATE_API_TOKEN=     AI song-section detection
# ADMIN_EMAILS=            Comma-separated admin allowlist (a `sensitive` var in
#                          Vercel: write-only, reads back as "")
# CRON_SECRET=             Guards api/cron/purge-trash
